----
import {
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

async fn run(target : String, args : Array[String], expected : Int) -> @shell.Output {
  let result = @shell.Cmd("moon", ["run", "--target", target, "--deny-warn", "lib/cli", "--"] + args).output(timeout_ms=120000)
  if result.exit_code() != expected {
    fail("CLI \{Repr(args)} exited \{result.exit_code()}, expected \{expected}: \{result.stderr()}")
  }
  if expected == 2 {
    guard @json.parse(result.stderr()) is { "code": String(_), "path": String(_), "message": String(_), .. } else { fail("unstructured diagnostic") }
    assert_eq(result.stdout(), "")
  } else if ["sarif", "sarif-cdx", "sarif-bom", "sarif-located", "sarif-bom-located"].contains(args[0]) {
    guard @json.parse(result.stdout()) is { "version": "2.1.0", "runs": Array([{ "properties": { "yuejian/exit_code": Number(code, ..), .. }, .. }]), .. } && code == expected.to_double() else { fail("SARIF gate disagrees with process exit") }
  } else if !["snapshot", "capture", "capture-bom", "help"].contains(args[0]) {
    guard @json.parse(result.stdout()) is { "exit_code": Number(code, ..), .. } && code == expected.to_double() else { fail("exit code disagrees with report") }
  }
  result
}

async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  let advisory = "samples/RUSTSEC-2020-0071.json"
  let direct = run(target, ["check", "samples/installed.json", advisory], 1)
  let report = @json.parse(direct.stdout())
  guard report is { "decisions": Array([
    { "outcome": String(before), .. }, { "outcome": String(after), .. }
  ]), .. } else { fail("real advisory decisions missing") }
  assert_eq(before, "affected")
  assert_eq(after, "not_matched")
  run(target, ["check", "samples/fixed.json", advisory], 0) |> ignore
  run(target, ["check", "samples/unknown.json", advisory], 3) |> ignore
  run(target, ["check", "samples/installed.json", advisory, advisory], 2) |> ignore
  run(target, ["check", "samples/missing.json", advisory], 2) |> ignore
  run(target, ["check", "samples/installed.json"], 2) |> ignore
  run(target, ["help"], 0) |> ignore
  let snap = run(target, ["snapshot", advisory], 0)
  let temp = "_build/yuejian-e2e-" + @env.now().to_string()
  @fs.mkdir(temp)
  defer @fs.rmdir(temp)
  let path = temp + "/snapshot.json"
  @fs.write_file(path, @utf8.encode(snap.stdout()))
  defer @fs.remove(path)
  let replay = run(target, ["replay", "samples/installed.json", path], 1)
  assert_eq(direct.stdout(), replay.stdout())
  run(target, ["replay", "samples/fixed.json", path], 0) |> ignore
  @fs.write_file(path, b"{\"schema_version\":1,\"documents\":[],\"typo\":true}")
  run(target, ["replay", "samples/fixed.json", path], 2) |> ignore
  @fs.write_file(path, b"\xff")
  run(target, ["replay", "samples/fixed.json", path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(snap.stdout()))
  run(target, ["replay", "samples/fixed.json", path], 0) |> ignore
  let captured = run(target, ["capture", "samples/installed.json", advisory], 0)
  let delivery_path = temp + "/delivery.json"
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  defer @fs.remove(delivery_path)
  let verified = run(target, ["verify", delivery_path], 1)
  assert_eq(verified.stdout(), direct.stdout())
  let corrupted = @json.parse(captured.stdout())
  guard corrupted is Object(fields) else { fail("missing delivery envelope") }
  fields["report"] = Json("{}")
  @fs.write_file(delivery_path, @utf8.encode(corrupted.stringify()))
  run(target, ["verify", delivery_path], 2) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  run(target, ["verify", delivery_path], 1) |> ignore
  let fixed = run(target, ["capture", "samples/fixed.json", advisory], 0)
  @fs.write_file(delivery_path, @utf8.encode(fixed.stdout()))
  run(target, ["verify", delivery_path], 0) |> ignore
  let unknown = run(target, ["capture", "samples/unknown.json", advisory], 0)
  @fs.write_file(delivery_path, @utf8.encode(unknown.stdout()))
  run(target, ["verify", delivery_path], 3) |> ignore
  run(target, ["capture", "samples/installed.json", advisory, advisory], 2) |> ignore
  let prior_path = temp + "/before.delivery.json"
  @fs.write_file(prior_path, @utf8.encode(fixed.stdout()))
  defer @fs.remove(prior_path)
  let affected = run(target, ["capture", "samples/before-fix.json", advisory], 0)
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(target, ["changes", prior_path, delivery_path], 1) |> ignore
  run(target, ["changes", delivery_path, prior_path], 0) |> ignore
  let retained = run(target, ["changes", delivery_path, delivery_path], 0)
  guard @json.parse(retained.stdout()) is { "current_exit_code": Number(current_code, ..), .. } && current_code == 1.0 else { fail("delta masked absolute hit") }
  @fs.write_file(delivery_path, b"{}")
  run(target, ["changes", prior_path, delivery_path], 2) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(target, ["changes", prior_path, delivery_path], 1) |> ignore
  run(target, ["check-cdx", "samples/cargo.cdx.json", advisory], 1) |> ignore
  run(target, ["check-cdx", "samples/cargo-fixed.cdx.json", advisory], 0) |> ignore
  run(target, ["check-cdx", "samples/cargo-partial.cdx.json", advisory], 3) |> ignore
  run(target, ["check-cdx", "samples/missing.json", advisory], 2) |> ignore
  let bom = @fs.read_file("samples/cargo.cdx.json").text()
  @fs.write_file(path, @utf8.encode(bom.replace(old="\"1.6\"", new="\"1.7\"")))
  run(target, ["check-cdx", path, advisory], 2) |> ignore
  @fs.write_file(path, @utf8.encode(bom.replace(old="\"bom-ref\":\"time\"", new="\"bom-ref\":\"time\",\"bom-ref\":\"other\"")))
  run(target, ["check-cdx", path, advisory], 2) |> ignore
  run(target, ["check-cdx", "samples/cargo-fixed.cdx.json", advisory], 0) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  let sarif = run(target, ["sarif", delivery_path, "samples/installed.json"], 1)
  @fs.write_file("_build/yuejian-sarif-example.json", @utf8.encode(sarif.stdout()))
  run(target, ["sarif", prior_path, "samples/fixed.json"], 0) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(unknown.stdout()))
  run(target, ["sarif", delivery_path, "samples/unknown.json"], 3) |> ignore
  @fs.write_file(delivery_path, b"{}")
  run(target, ["sarif", delivery_path, "samples/installed.json"], 2) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(target, ["sarif", delivery_path, "samples/before-fix.json"], 1) |> ignore
  run(target, ["sarif", delivery_path, "../inventory.json"], 2) |> ignore
  run(target, ["sarif-cdx", "samples/cargo.cdx.json", "samples/cargo.cdx.json", advisory], 1) |> ignore
  run(target, ["sarif-cdx", "samples/cargo-fixed.cdx.json", "samples/cargo-fixed.cdx.json", advisory], 0) |> ignore
  let bom_sarif = run(target, ["sarif-cdx", "samples/cargo-partial.cdx.json", "samples/cargo-partial.cdx.json", advisory], 3)
  @fs.write_file("_build/yuejian-bom-sarif-example.json", @utf8.encode(bom_sarif.stdout()))
  run(target, ["sarif-cdx", "samples/cargo-partial.cdx.json", "../bom.json", advisory], 2) |> ignore
  run(target, ["sarif-cdx", path, "bom.json", advisory], 2) |> ignore
  run(target, ["check-bom", "samples/cargo.spdx.json", advisory], 1) |> ignore
  run(target, ["sarif-bom", "samples/cargo.spdx.json", "samples/cargo.spdx.json", advisory], 1) |> ignore
  run(target, ["check-bom", "samples/cargo-fixed.cdx.json", advisory], 0) |> ignore
  let spdx = @fs.read_file("samples/cargo.spdx.json").text()
  @fs.write_file(path, @utf8.encode(spdx.replace(old="0.2.22", new="0.2.23").replace(old="0.2.22", new="0.2.23")))
  run(target, ["check-bom", path, advisory], 0) |> ignore
  @fs.write_file(path, @utf8.encode(spdx.replace(old="pkg:cargo", new="pkg:npm")))
  run(target, ["check-bom", path, advisory], 3) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["check-bom", path, advisory], 2) |> ignore
  run(target, ["check-bom", "samples/cargo.spdx.json", advisory], 1) |> ignore
  let bom_receipt = run(target, ["capture-bom", "samples/cargo-partial.cdx.json", advisory], 0)
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["verify-bom", path], 3) |> ignore
  let spdx_receipt = run(target, ["capture-bom", "samples/cargo.spdx.json", advisory], 0)
  @fs.write_file(path, @utf8.encode(spdx_receipt.stdout()))
  run(target, ["verify-bom", path], 1) |> ignore
  let fixed_receipt = run(target, ["capture-bom", "samples/cargo-fixed.cdx.json", advisory], 0)
  @fs.write_file(path, @utf8.encode(fixed_receipt.stdout()))
  run(target, ["verify-bom", path], 0) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["verify-bom", path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["verify-bom", path], 3) |> ignore
  let hit_receipt = run(target, ["capture-bom", "samples/cargo.cdx.json", advisory], 0)
  @fs.write_file(prior_path, @utf8.encode(fixed_receipt.stdout()))
  @fs.write_file(path, @utf8.encode(hit_receipt.stdout()))
  run(target, ["changes-bom", prior_path, path], 1) |> ignore
  run(target, ["changes-bom", path, prior_path], 0) |> ignore
  let retained_bom = run(target, ["changes-bom", path, path], 0)
  guard @json.parse(retained_bom.stdout()) is { "current_exit_code": 1, .. } else { fail("BOM delta masked current finding") }
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["changes-bom", path, prior_path], 3) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["changes-bom", path, prior_path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(hit_receipt.stdout()))
  run(target, ["changes-bom", prior_path, path], 1) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  let located = run(target, ["sarif-located", delivery_path, "samples/installed.json", "samples/installed.json"], 1)
  @fs.write_file("_build/yuejian-located-sarif-example.json", @utf8.encode(located.stdout()))
  run(target, ["sarif-located", delivery_path, "samples/fixed.json", "inventory.json"], 2) |> ignore
  run(target, ["sarif-located", delivery_path, "samples/missing.json", "inventory.json"], 2) |> ignore
  run(target, ["sarif-located", delivery_path, path, "inventory.json"], 2) |> ignore
  let inventory = @fs.read_file("samples/installed.json").json()
  guard inventory is Object(inventory_fields) && inventory_fields["packages"] is Array([a, b]) else { fail("inventory fixtures changed") }
  inventory_fields["packages"] = Json([b, a])
  @fs.write_file(path, inventory)
  run(target, ["sarif-located", delivery_path, path, "inventory.json"], 1) |> ignore
  let located_spdx = run(target, ["sarif-bom-located", "samples/cargo.spdx.json", "samples/cargo.spdx.json", advisory], 1)
  @fs.write_file("_build/yuejian-spdx-sarif-example.json", @utf8.encode(located_spdx.stdout()))
  let located_partial = run(target, ["sarif-bom-located", "samples/cargo-partial.cdx.json", "samples/cargo-partial.cdx.json", advisory], 3)
  @fs.write_file("_build/yuejian-located-bom-sarif-example.json", @utf8.encode(located_partial.stdout()))
  run(target, ["sarif-bom-located", path, "bom.json", advisory], 2) |> ignore
  run(target, ["sarif-bom-located", "samples/cargo-fixed.cdx.json", "samples/cargo-fixed.cdx.json", advisory], 0) |> ignore
  let expensive = "{\"bomFormat\":\"CycloneDX\",\"specVersion\":\"1.6\",\"extension\":{\"" + "x".repeat(5000) + "\":[" + Array::make(4000, "null").join(",") + "]},\"components\":[]}"
  @fs.write_file(path, @utf8.encode(expensive))
  run(target, ["check-bom", path, advisory], 2) |> ignore
  run(target, ["capture-bom", path, advisory], 2) |> ignore
  run(target, ["check-bom", "samples/cargo-fixed.cdx.json", advisory], 0) |> ignore
  println("80 end-to-end scenarios passed on \{target}; bounded metadata parsing and recovery verified")
}
