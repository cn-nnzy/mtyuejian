----
import {
  "moonbitlang/async/fs",
  "moonbitlang/async/shell",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
let scenario_count : Ref[Int32] = Ref(0)

///|
async fn run(
  target : String,
  args : Array[String],
  expected : Int32,
) -> @shell.Output {
  scenario_count.val += 1
  let result = @shell.Cmd(
    "moon",
    ["run", "--target", target, "--deny-warn", "lib/cli", "--"] + args,
  ).output(timeout_ms=120000)
  if result.exit_code() != expected {
    fail(
      "CLI \{Repr(args)} exited \{result.exit_code()}, expected \{expected}: \{result.stderr()}",
    )
  }
  if expected == 2 {
    guard @json.parse(result.stderr())
      is { "code": String(_), "path": String(_), "message": String(_), .. } else {
      fail("unstructured diagnostic")
    }
    assert_eq(result.stdout(), "")
  } else if [
      "sarif", "sarif-cdx", "sarif-bom", "sarif-located", "sarif-bom-located",
    ].contains(args[0]) {
    guard @json.parse(result.stdout())
      is {
        "version": "2.1.0",
        "runs": Array(
          [{ "properties": { "yuejian/exit_code": Number(code, ..), .. }, .. }],
        ),
        ..
      } &&
      code == expected.to_double() else {
      fail("SARIF gate disagrees with process exit")
    }
  } else if ![
      "snapshot", "capture", "capture-bom", "review", "review-bom", "help",
    ].contains(args[0]) {
    guard @json.parse(result.stdout()) is { "exit_code": Number(code, ..), .. } &&
      code == expected.to_double() else {
      fail("exit code disagrees with report")
    }
  }
  result
}

///|
async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  let advisory = "samples/RUSTSEC-2020-0071.json"
  let direct = run(target, ["check", "samples/installed.json", advisory], 1)
  let report = @json.parse(direct.stdout())
  guard report
    is {
      "decisions": Array(
        [{ "outcome": String(before), .. }, { "outcome": String(after), .. }],
      ),
      ..
    } else {
    fail("real advisory decisions missing")
  }
  assert_eq(before, "affected")
  assert_eq(after, "not_matched")
  run(target, ["check", "samples/fixed.json", advisory], 0) |> ignore
  run(target, ["check", "samples/unknown.json", advisory], 3) |> ignore
  run(target, ["check", "samples/installed.json", advisory, advisory], 2)
  |> ignore
  run(target, ["check", "samples/missing.json", advisory], 2) |> ignore
  run(target, ["check", "samples/installed.json"], 2) |> ignore
  run(target, ["help"], 0) |> ignore
  let snap = run(target, ["snapshot", advisory], 0)
  let temp = "_build/yuejian-e2e-" + @env.now().to_string()
  @fs.mkdir(temp)
  defer @fs.rmdir(temp)
  let path = temp + "/snapshot.json"
  @fs.write_file(path, @utf8.encode(snap.stdout()))
  defer @fs.remove(path)
  let replay = run(target, ["replay", "samples/installed.json", path], 1)
  assert_eq(direct.stdout(), replay.stdout())
  run(target, ["replay", "samples/fixed.json", path], 0) |> ignore
  @fs.write_file(path, b"{\"schema_version\":1,\"documents\":[],\"typo\":true}")
  run(target, ["replay", "samples/fixed.json", path], 2) |> ignore
  @fs.write_file(path, b"\xff")
  run(target, ["replay", "samples/fixed.json", path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(snap.stdout()))
  run(target, ["replay", "samples/fixed.json", path], 0) |> ignore
  let captured = run(target, ["capture", "samples/installed.json", advisory], 0)
  let delivery_path = temp + "/delivery.json"
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  defer @fs.remove(delivery_path)
  let verified = run(target, ["verify", delivery_path], 1)
  assert_eq(verified.stdout(), direct.stdout())
  let corrupted = @json.parse(captured.stdout())
  guard corrupted is Object(fields) else { fail("missing delivery envelope") }
  fields["report"] = Json("{}")
  @fs.write_file(delivery_path, @utf8.encode(corrupted.stringify()))
  run(target, ["verify", delivery_path], 2) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  run(target, ["verify", delivery_path], 1) |> ignore
  let fixed = run(target, ["capture", "samples/fixed.json", advisory], 0)
  @fs.write_file(delivery_path, @utf8.encode(fixed.stdout()))
  run(target, ["verify", delivery_path], 0) |> ignore
  let unknown = run(target, ["capture", "samples/unknown.json", advisory], 0)
  @fs.write_file(delivery_path, @utf8.encode(unknown.stdout()))
  run(target, ["verify", delivery_path], 3) |> ignore
  run(target, ["capture", "samples/installed.json", advisory, advisory], 2)
  |> ignore
  let prior_path = temp + "/before.delivery.json"
  @fs.write_file(prior_path, @utf8.encode(fixed.stdout()))
  defer @fs.remove(prior_path)
  let affected = run(
    target,
    ["capture", "samples/before-fix.json", advisory],
    0,
  )
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(target, ["changes", prior_path, delivery_path], 1) |> ignore
  run(target, ["changes", delivery_path, prior_path], 0) |> ignore
  let retained = run(target, ["changes", delivery_path, delivery_path], 0)
  guard @json.parse(retained.stdout())
    is { "current_exit_code": Number(current_code, ..), .. } &&
    current_code == 1.0 else {
    fail("delta masked absolute hit")
  }
  @fs.write_file(delivery_path, b"{}")
  run(target, ["changes", prior_path, delivery_path], 2) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(target, ["changes", prior_path, delivery_path], 1) |> ignore
  run(target, ["check-cdx", "samples/cargo.cdx.json", advisory], 1) |> ignore
  run(target, ["check-cdx", "samples/cargo-fixed.cdx.json", advisory], 0)
  |> ignore
  run(target, ["check-cdx", "samples/cargo-partial.cdx.json", advisory], 3)
  |> ignore
  run(target, ["check-cdx", "samples/missing.json", advisory], 2) |> ignore
  let bom = @fs.read_file("samples/cargo.cdx.json").text()
  let scope = run(
    target,
    ["compare-bom-scope", "samples/cargo.cdx.json", "samples/cargo.spdx.json"],
    0,
  )
  guard @json.parse(scope.stdout())
    is {
      "profile": "cargo-bom-scope-v1",
      "counts": { "shared_instances": 1, .. },
      ..
    } else {
    fail("Expected the same Cargo identity across formats")
  }
  run(
    target,
    [
      "compare-bom-scope", "samples/cargo.cdx.json", "samples/cargo-fixed.cdx.json",
    ],
    3,
  )
  |> ignore
  run(
    target,
    [
      "compare-bom-scope", "samples/cargo.cdx.json", "samples/cargo-partial.cdx.json",
    ],
    3,
  )
  |> ignore
  run(
    target,
    ["compare-bom-scope", "samples/cargo.cdx.json", "samples/missing.json"],
    2,
  )
  |> ignore
  run(
    target,
    ["compare-bom-scope", "samples/cargo.cdx.json", "samples/installed.json"],
    2,
  )
  |> ignore
  @fs.write_file(path, @utf8.encode(bom.replace(old="\"1.6\"", new="\"1.7\"")))
  run(target, ["check-cdx", path, advisory], 1) |> ignore
  @fs.write_file(path, @utf8.encode(bom.replace(old="\"1.6\"", new="\"1.8\"")))
  run(target, ["check-cdx", path, advisory], 2) |> ignore
  @fs.write_file(
    path,
    @utf8.encode(
      bom.replace(
        old="\"bom-ref\":\"time\"",
        new="\"bom-ref\":\"time\",\"bom-ref\":\"other\"",
      ),
    ),
  )
  run(target, ["check-cdx", path, advisory], 2) |> ignore
  run(target, ["check-cdx", "samples/cargo-fixed.cdx.json", advisory], 0)
  |> ignore
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  let sarif = run(target, ["sarif", delivery_path, "samples/installed.json"], 1)
  @fs.write_file(
    "_build/yuejian-sarif-example.json",
    @utf8.encode(sarif.stdout()),
  )
  run(target, ["sarif", prior_path, "samples/fixed.json"], 0) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(unknown.stdout()))
  run(target, ["sarif", delivery_path, "samples/unknown.json"], 3) |> ignore
  @fs.write_file(delivery_path, b"{}")
  run(target, ["sarif", delivery_path, "samples/installed.json"], 2) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(target, ["sarif", delivery_path, "samples/before-fix.json"], 1) |> ignore
  run(target, ["sarif", delivery_path, "../inventory.json"], 2) |> ignore
  run(
    target,
    ["sarif-cdx", "samples/cargo.cdx.json", "samples/cargo.cdx.json", advisory],
    1,
  )
  |> ignore
  run(
    target,
    [
      "sarif-cdx", "samples/cargo-fixed.cdx.json", "samples/cargo-fixed.cdx.json",
      advisory,
    ],
    0,
  )
  |> ignore
  let bom_sarif = run(
    target,
    [
      "sarif-cdx", "samples/cargo-partial.cdx.json", "samples/cargo-partial.cdx.json",
      advisory,
    ],
    3,
  )
  @fs.write_file(
    "_build/yuejian-bom-sarif-example.json",
    @utf8.encode(bom_sarif.stdout()),
  )
  run(
    target,
    ["sarif-cdx", "samples/cargo-partial.cdx.json", "../bom.json", advisory],
    2,
  )
  |> ignore
  run(target, ["sarif-cdx", path, "bom.json", advisory], 2) |> ignore
  run(target, ["check-bom", "samples/cargo.spdx.json", advisory], 1) |> ignore
  run(
    target,
    [
      "sarif-bom", "samples/cargo.spdx.json", "samples/cargo.spdx.json", advisory,
    ],
    1,
  )
  |> ignore
  run(target, ["check-bom", "samples/cargo-fixed.cdx.json", advisory], 0)
  |> ignore
  let spdx = @fs.read_file("samples/cargo.spdx.json").text()
  @fs.write_file(
    path,
    @utf8.encode(
      spdx
      .replace(old="0.2.22", new="0.2.23")
      .replace(old="0.2.22", new="0.2.23"),
    ),
  )
  run(target, ["check-bom", path, advisory], 0) |> ignore
  @fs.write_file(
    path,
    @utf8.encode(spdx.replace(old="pkg:cargo", new="pkg:npm")),
  )
  run(target, ["check-bom", path, advisory], 3) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["check-bom", path, advisory], 2) |> ignore
  run(target, ["check-bom", "samples/cargo.spdx.json", advisory], 1) |> ignore
  let bom_receipt = run(
    target,
    ["capture-bom", "samples/cargo-partial.cdx.json", advisory],
    0,
  )
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["verify-bom", path], 3) |> ignore
  let spdx_receipt = run(
    target,
    ["capture-bom", "samples/cargo.spdx.json", advisory],
    0,
  )
  @fs.write_file(path, @utf8.encode(spdx_receipt.stdout()))
  run(target, ["verify-bom", path], 1) |> ignore
  let fixed_receipt = run(
    target,
    ["capture-bom", "samples/cargo-fixed.cdx.json", advisory],
    0,
  )
  @fs.write_file(path, @utf8.encode(fixed_receipt.stdout()))
  run(target, ["verify-bom", path], 0) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["verify-bom", path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["verify-bom", path], 3) |> ignore
  let hit_receipt = run(
    target,
    ["capture-bom", "samples/cargo.cdx.json", advisory],
    0,
  )
  @fs.write_file(prior_path, @utf8.encode(fixed_receipt.stdout()))
  @fs.write_file(path, @utf8.encode(hit_receipt.stdout()))
  run(target, ["changes-bom", prior_path, path], 1) |> ignore
  run(target, ["changes-bom", path, prior_path], 0) |> ignore
  let retained_bom = run(target, ["changes-bom", path, path], 0)
  guard @json.parse(retained_bom.stdout()) is { "current_exit_code": 1, .. } else {
    fail("BOM delta masked current finding")
  }
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["changes-bom", path, prior_path], 3) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["changes-bom", path, prior_path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(hit_receipt.stdout()))
  run(target, ["changes-bom", prior_path, path], 1) |> ignore
  @fs.write_file(delivery_path, @utf8.encode(captured.stdout()))
  let located = run(
    target,
    [
      "sarif-located", delivery_path, "samples/installed.json", "samples/installed.json",
    ],
    1,
  )
  @fs.write_file(
    "_build/yuejian-located-sarif-example.json",
    @utf8.encode(located.stdout()),
  )
  run(
    target,
    ["sarif-located", delivery_path, "samples/fixed.json", "inventory.json"],
    2,
  )
  |> ignore
  run(
    target,
    ["sarif-located", delivery_path, "samples/missing.json", "inventory.json"],
    2,
  )
  |> ignore
  run(target, ["sarif-located", delivery_path, path, "inventory.json"], 2)
  |> ignore
  let inventory = @fs.read_file("samples/installed.json").json()
  guard inventory is Object(inventory_fields) &&
    inventory_fields["packages"] is Array([a, b]) else {
    fail("inventory fixtures changed")
  }
  inventory_fields["packages"] = Json([b, a])
  @fs.write_file(path, inventory)
  run(target, ["sarif-located", delivery_path, path, "inventory.json"], 1)
  |> ignore
  let located_spdx = run(
    target,
    [
      "sarif-bom-located", "samples/cargo.spdx.json", "samples/cargo.spdx.json",
      advisory,
    ],
    1,
  )
  @fs.write_file(
    "_build/yuejian-spdx-sarif-example.json",
    @utf8.encode(located_spdx.stdout()),
  )
  let located_partial = run(
    target,
    [
      "sarif-bom-located", "samples/cargo-partial.cdx.json", "samples/cargo-partial.cdx.json",
      advisory,
    ],
    3,
  )
  @fs.write_file(
    "_build/yuejian-located-bom-sarif-example.json",
    @utf8.encode(located_partial.stdout()),
  )
  run(target, ["sarif-bom-located", path, "bom.json", advisory], 2) |> ignore
  run(
    target,
    [
      "sarif-bom-located", "samples/cargo-fixed.cdx.json", "samples/cargo-fixed.cdx.json",
      advisory,
    ],
    0,
  )
  |> ignore
  let expensive = "{\"bomFormat\":\"CycloneDX\",\"specVersion\":\"1.6\",\"extension\":{\"" +
    "x".repeat(5000) +
    "\":[" +
    Array::make(4000, "null").join(",") +
    "]},\"components\":[]}"
  @fs.write_file(path, @utf8.encode(expensive))
  run(target, ["check-bom", path, advisory], 2) |> ignore
  run(target, ["capture-bom", path, advisory], 2) |> ignore
  run(target, ["check-bom", "samples/cargo-fixed.cdx.json", advisory], 0)
  |> ignore
  guard @json.parse(captured.stdout()) is { "sha256": String(hit_pin), .. } &&
    @json.parse(fixed.stdout()) is { "sha256": String(fixed_pin), .. } &&
    @json.parse(bom_receipt.stdout()) is { "sha256": String(bom_pin), .. } &&
    @json.parse(fixed_receipt.stdout())
    is { "sha256": String(fixed_bom_pin), .. } else {
    fail("receipt digests missing")
  }
  run(target, ["verify", "--expected-sha256", hit_pin, delivery_path], 1)
  |> ignore
  run(target, ["verify", "--expected-sha256", fixed_pin, delivery_path], 2)
  |> ignore
  run(target, ["verify", "--expected-sha256", "invalid", delivery_path], 2)
  |> ignore
  @fs.write_file(path, @utf8.encode(bom_receipt.stdout()))
  run(target, ["verify-bom", "--expected-sha256", bom_pin, path], 3) |> ignore
  run(target, ["verify-bom", "--expected-sha256", fixed_bom_pin, path], 2)
  |> ignore
  @fs.write_file(prior_path, @utf8.encode(fixed.stdout()))
  @fs.write_file(delivery_path, @utf8.encode(affected.stdout()))
  run(
    target,
    ["changes", "--baseline-sha256", fixed_pin, prior_path, delivery_path],
    1,
  )
  |> ignore
  run(
    target,
    ["changes", "--baseline-sha256", hit_pin, prior_path, delivery_path],
    2,
  )
  |> ignore
  @fs.write_file(prior_path, @utf8.encode(fixed_receipt.stdout()))
  @fs.write_file(path, @utf8.encode(hit_receipt.stdout()))
  run(
    target,
    ["changes-bom", "--baseline-sha256", fixed_bom_pin, prior_path, path],
    1,
  )
  |> ignore
  run(
    target,
    ["changes-bom", "--baseline-sha256", bom_pin, prior_path, path],
    2,
  )
  |> ignore
  run(
    target,
    ["changes-bom", "--baseline-sha256", fixed_bom_pin, prior_path, path],
    1,
  )
  |> ignore
  let related_advisory = "samples/GHSA-wcg3-cvx6-7396.json"
  let linked = run(
    target,
    ["capture", "samples/installed.json", advisory, related_advisory],
    0,
  )
  @fs.write_file(delivery_path, @utf8.encode(linked.stdout()))
  let alias_report = run(target, ["aliases", delivery_path], 1)
  guard @json.parse(alias_report.stdout())
    is {
      "groups": Array(
        [
          {
            "records": Array([_, _]),
            "decision_indices": Array([0, 1, 2, 3]),
            "has_known_match": true,
            "has_incomplete_evidence": true,
            ..
          },
        ],
      ),
      "report": { "decisions": Array([_, _, _, _]), .. },
      ..
    } else {
    fail("real dual-source evidence was merged or lost")
  }
  let linked_bom = run(
    target,
    [
      "capture-bom", "samples/cargo-partial.cdx.json", advisory, related_advisory,
    ],
    0,
  )
  @fs.write_file(path, @utf8.encode(linked_bom.stdout()))
  run(target, ["aliases-bom", path], 3) |> ignore
  run(target, ["aliases", path], 2) |> ignore
  run(target, ["aliases-bom", delivery_path], 2) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["aliases-bom", path], 2) |> ignore
  run(target, ["aliases", delivery_path], 1) |> ignore
  @fs.write_file(path, @utf8.encode(linked_bom.stdout()))
  run(target, ["aliases-bom", path], 3) |> ignore
  let markdown = run(target, ["review", delivery_path], 0)
  assert_true(markdown.stdout().contains("Assessment exit code: 1"))
  assert_true(markdown.stdout().contains("undetermined: 2"))
  @fs.write_file("_build/yuejian-review.md", markdown.stdout())
  let bom_markdown = run(target, ["review-bom", path], 0)
  assert_true(bom_markdown.stdout().contains("Assessment exit code: 3"))
  assert_true(bom_markdown.stdout().contains("Unresolved entries: 1"))
  @fs.write_file("_build/yuejian-bom-review.md", bom_markdown.stdout())
  guard @json.parse(linked.stdout()) is { "sha256": String(linked_pin), .. } &&
    @json.parse(linked_bom.stdout()) is { "sha256": String(linked_bom_pin), .. } else {
    fail("linked receipt digests missing")
  }
  run(target, ["review", "--expected-sha256", linked_pin, delivery_path], 0)
  |> ignore
  run(target, ["review", "--expected-sha256", fixed_pin, delivery_path], 2)
  |> ignore
  run(target, ["review-bom", "--expected-sha256", linked_bom_pin, path], 0)
  |> ignore
  run(target, ["review-bom", "--expected-sha256", bom_pin, path], 2) |> ignore
  run(target, ["review-bom", delivery_path], 2) |> ignore
  @fs.write_file(path, b"{}")
  run(target, ["review-bom", path], 2) |> ignore
  @fs.write_file(path, @utf8.encode(linked_bom.stdout()))
  run(target, ["review-bom", path], 0) |> ignore
  let untrusted = @fs.read_file("samples/fixed.json").json()
  guard untrusted is { "packages": Array([Object(untrusted_item)]), .. } else {
    fail("single package fixture changed")
  }
  untrusted_item["id"] = Json(
    "id```<script>test</script>\n# heading\n[link](https://example.invalid/) | 😀",
  )
  @fs.write_file(path, untrusted)
  let untrusted_receipt = run(target, ["capture", path, advisory], 0)
  @fs.write_file(path, @utf8.encode(untrusted_receipt.stdout()))
  let untrusted_markdown = run(target, ["review", path], 0)
  @fs.write_file(
    "_build/yuejian-untrusted-review.md",
    untrusted_markdown.stdout(),
  )
  run(target, ["review", "--expected-sha256", "invalid", path], 2) |> ignore
  run(target, ["review", path], 0) |> ignore
  @fs.write_file(delivery_path, captured.stdout())
  let covered = run(target, ["coverage", delivery_path], 1)
  guard @json.parse(covered.stdout())
    is {
      "profile": "coverage-review-v1",
      "counts": { "resolved_packages": 2, .. },
      ..
    } else {
    fail("Coverage omitted installed packages")
  }
  run(target, ["coverage", "--expected-sha256", hit_pin, delivery_path], 1)
  |> ignore
  run(target, ["coverage", "--expected-sha256", fixed_pin, delivery_path], 2)
  |> ignore
  @fs.write_file(delivery_path, fixed.stdout())
  run(target, ["coverage", delivery_path], 0) |> ignore
  @fs.write_file(delivery_path, unknown.stdout())
  run(target, ["coverage", delivery_path], 3) |> ignore
  @fs.write_file(path, bom_receipt.stdout())
  let bom_coverage = run(target, ["coverage-bom", path], 3)
  guard @json.parse(bom_coverage.stdout())
    is {
      "counts": { "unresolved_entries": 1, .. },
      "diagnostics": Array(
        [{ "category": "unsupported_identity", "next_action": String(_), .. }],
      ),
      ..
    } else {
    fail("Incomplete BOM has no actionable coverage diagnostic")
  }
  run(target, ["coverage-bom", "--expected-sha256", bom_pin, path], 3) |> ignore
  run(target, ["coverage-bom", "--expected-sha256", fixed_bom_pin, path], 2)
  |> ignore
  run(target, ["coverage", path], 2) |> ignore
  run(target, ["coverage-bom", delivery_path], 2) |> ignore
  @fs.write_file(path, "{}")
  run(target, ["coverage-bom", path], 2) |> ignore
  @fs.write_file(path, bom_receipt.stdout())
  run(target, ["coverage-bom", path], 3) |> ignore
  let legacy = "samples/compat/moon-20261119.delivery.json"
  let legacy_pin = "52705615554224e88dd1dea8b81b98550c2a4e1298ba6c08c5a0dbd9cfd39a5b"
  run(target, ["verify", "--expected-sha256", legacy_pin, legacy], 1) |> ignore
  run(target, ["coverage", legacy], 1) |> ignore
  run(target, ["review", legacy], 0) |> ignore
  run(target, ["verify", "--expected-sha256", fixed_pin, legacy], 2) |> ignore
  // Compare the JSON payload; terminal line endings are not receipt content.
  assert_eq(
    affected.stdout().trim().to_owned(),
    @fs.read_file(legacy).text().trim().to_owned(),
  )
  let crates_doc = "samples/GHSA-wcg3-cvx6-7396.json"
  run(target, ["check", "--crates-io", "samples/installed.json", crates_doc], 1)
  |> ignore
  run(target, ["check", "--crates-io", "samples/fixed.json", crates_doc], 0)
  |> ignore
  let crates_hit = run(
    target,
    ["capture", "--crates-io", "samples/installed.json", crates_doc],
    0,
  )
  @fs.write_file(delivery_path, crates_hit.stdout())
  run(target, ["verify", delivery_path], 1) |> ignore
  run(target, ["coverage", delivery_path], 1) |> ignore
  run(target, ["review", delivery_path], 0) |> ignore
  let crates_snapshot = run(target, ["snapshot", "--crates-io", crates_doc], 0)
  @fs.write_file(path, crates_snapshot.stdout())
  run(target, ["replay", "samples/fixed.json", path], 0) |> ignore
  let crates_bom = run(
    target,
    ["capture-bom", "--crates-io", "samples/cargo-fixed.cdx.json", crates_doc],
    0,
  )
  @fs.write_file(path, crates_bom.stdout())
  run(target, ["verify-bom", path], 0) |> ignore
  run(
    target,
    [
      "sarif-bom-located", "--crates-io", "samples/cargo-fixed.cdx.json", "samples/cargo-fixed.cdx.json",
      crates_doc,
    ],
    0,
  )
  |> ignore
  let old_fixed = run(target, ["capture", "samples/fixed.json", crates_doc], 0)
  let crates_fixed = run(
    target,
    ["capture", "--crates-io", "samples/fixed.json", crates_doc],
    0,
  )
  @fs.write_file(prior_path, old_fixed.stdout())
  @fs.write_file(delivery_path, crates_fixed.stdout())
  run(target, ["changes", prior_path, delivery_path], 3) |> ignore
  run(target, ["verify", "--crates-io", delivery_path], 2) |> ignore
  run(
    target,
    ["check", "--crates-io", "--crates-io", "samples/fixed.json", crates_doc],
    2,
  )
  |> ignore
  @fs.write_file(
    path,
    crates_snapshot
    .stdout()
    .replace(old="crates-io-semver-v1", new="unknown-v1"),
  )
  run(target, ["replay", "samples/fixed.json", path], 2) |> ignore
  @fs.write_file(path, crates_snapshot.stdout())
  run(target, ["replay", "samples/fixed.json", path], 0) |> ignore
  let old_bom = run(
    target,
    ["capture-bom", "samples/cargo-fixed.cdx.json", crates_doc],
    0,
  )
  @fs.write_file(prior_path, old_bom.stdout())
  @fs.write_file(path, crates_bom.stdout())
  run(target, ["changes-bom", prior_path, path], 3) |> ignore
  println(
    "\{scenario_count.val} CLI scenarios passed on \{target}; crates profile, legacy receipt compatibility and recovery verified",
  )
}
